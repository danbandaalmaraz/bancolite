<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>com.danbanda</groupId>
    <artifactId>bancolite</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>BancoLite</name>
    <description>Proyecto de practica: mini banco con microservicios en Spring Boot desplegado en Google Cloud</description>

    <!-- cada carpeta es un microservicio independiente -->
    <modules>
        <module>servicio-cuentas</module>
        <module>servicio-transferencias</module>
        <module>servicio-notificaciones</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud-gcp.version>7.0.0</spring-cloud-gcp.version>
    </properties>

    <!-- aqui solo se declaran versiones de las librerias de Google Cloud,
         cada servicio decide cuales usa -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>spring-cloud-gcp-dependencies</artifactId>
                <version>${spring-cloud-gcp.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
